# Suvarnavarsha Gold website - settings.
# Copy this file to .env on your PC. On GoDaddy, enter the same names and values in the Node.js app's
# "Environment variables" section (or upload a .env file next to server.js). Never share or commit .env.

# production on the live site (turns on secure cookies and hides error details)
NODE_ENV=production
# The hosting usually sets PORT itself; 3000 is used when it is empty.
PORT=3000
# Leave empty to listen on all interfaces (normal for hosting). Use 127.0.0.1 to allow only this PC.
HOST=
# Full website address, no slash at the end. Used for links in messages and the sitemap.
SITE_URL=https://suvarnvarshagold.com
# How many proxies sit in front of the app (GoDaddy / Passenger: 1). Needed for correct visitor IPs and secure cookies.
TRUST_PROXY=1

# MySQL. With a hosted database attached in GoDaddy these five are set for you automatically (Secrets card);
# do not enter them again there. On a PC, fill them in. Tables and the first admin are created on start.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5
# Create tables and starting content on start (default). Set to false if the DB user may not create tables.
AUTO_MIGRATE=true

# Optional. Long random secrets, 32+ characters each. If left out, the app derives them from DB_PASSWORD.
# Make them with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
IP_HASH_SALT=

# First accounts, created on start only when missing (an existing account is never changed).
# Keep passwords only here / in the hosting settings, never in a file you share or commit.
# Super admin: everything, incl. Users and Settings. Admin: rates, videos, feedback, products, FAQs.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# One-time code for the "create first admin" screen at /admin/login. Set a long random value, create the
# admin, then delete this line (the screen also closes by itself once an admin exists).
# Leave empty to create the admin only with: npm run create-admin
SETUP_TOKEN=

# Other websites allowed to call the API (comma separated). Leave empty: the site and admin are on the same address.
CORS_ORIGINS=

