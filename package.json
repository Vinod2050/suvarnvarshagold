{
  "name": "suvarnavarsha-gold-website",
  "version": "1.0.0",
  "private": true,
  "description": "Suvarnavarsha Gold website and admin panel (Node.js + Express + MySQL + Bootstrap 5)",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build.js",
    "postinstall": "node scripts/build.js",
    "create-admin": "node scripts/create-admin.js",
    "zip": "node scripts/make-zip.js",
    "test": "node tests/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "bootstrap": "5.3.8",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "4.22.3",
    "express-mysql-session": "3.0.3",
    "express-rate-limit": "8.7.2",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "archiver": "8.0.0"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
